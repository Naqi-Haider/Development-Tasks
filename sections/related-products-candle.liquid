{% comment %} 
    Making this section totally custom independant on the dawn theme.
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'product-candle-extras.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient related-products-candle page-width section-{{ section.id }}-padding">
  {% if section.blocks.size > 0 %}
    <h2 class="related-products-candle__heading {{ section.settings.heading_size }}">
      {{ section.settings.heading }}
    </h2>
    <ul
      class="related-products-candle__grid grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      style="--columns-desktop: {{ section.settings.columns_desktop }};"
      role="list"
    >
      {% for block in section.blocks %}
        {% assign card_product = block.settings.product %}
        {% if card_product != blank %}
          {% assign variant = card_product.selected_or_first_available_variant %}
          <li class="related-products-candle__item" {{ block.shopify_attributes }}>
            <a href="{{ card_product.url }}" class="related-products-candle__media">
              <img
                srcset="{{ card_product.featured_image | image_url: width: 300 }} 300w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
                src="{{ card_product.featured_image | image_url: width: 600 }}"
                sizes="(min-width: 990px) 25vw, 50vw"
                alt="{{ card_product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ card_product.featured_image.width }}"
                height="{{ card_product.featured_image.height }}"
              >
            </a>
            <div class="related-products-candle__info">
              <a href="{{ card_product.url }}" class="related-products-candle__title">
                {{- card_product.title | escape -}}
              </a>
              {% if card_product.metafields.custom.subtitle.value != blank %}
                <p class="related-products-candle__subtitle">{{ card_product.metafields.custom.subtitle.value | escape }}</p>
              {% endif %}
              {% render 'price', product: card_product, price_class: '' %}
            </div>
            <form method="post" action="/cart/add" accept-charset="UTF-8" data-type="add-to-cart-form">
              <input
                type="hidden"
                name="id"
                value="{{ variant.id }}"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
              <button
                type="submit"
                name="add"
                class="related-products-candle__quick-add"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {% if variant.available %}Quick add{% else %}Sold out{% endif %}
              </button>
            </form>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% schema %}
{
  "name": "Related products (candle)",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "You may also like", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [
    {
      "name": "Related products (candle)",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
